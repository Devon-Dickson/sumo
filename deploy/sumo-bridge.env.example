# Copy to /etc/sumo-bridge/sumo-bridge.env and edit.
# Contains a secret, so: chmod 640, chown root:sumobridge

# Shared secret for BOTH the Newznab indexer and the SABnzbd download client
# entries in Sonarr. Generate with: openssl rand -hex 16
SUMO_API_KEY=changeme

# How Sonarr reaches this box. The .nzb links in the feed are built from it, so
# it must be the bridge LXC's address as Sonarr resolves it -- not localhost.
SUMO_PUBLIC_URL=http://192.168.1.50:8787

SUMO_HOST=0.0.0.0
SUMO_PORT=8787

# These must be paths on the SHARED volume, and must look the same from Sonarr.
# Match whatever your SABnzbd LXC already uses; if they differ, you will need a
# Remote Path Mapping in Sonarr.
SUMO_INCOMPLETE_DIR=/downloads/incomplete
SUMO_COMPLETE_DIR=/downloads/complete

# Keep this distinct from your real SABnzbd's categories. It is how Sonarr
# tells the two clients apart.
SUMO_CATEGORY=sumo

# Survives restarts. StateDirectory=sumo-bridge in the unit creates this.
SUMO_STATE_FILE=/var/lib/sumo-bridge/state.json

SUMO_MAX_CONCURRENT=1

# Correct the episode numbering when a tournament is cancelled. TheTVDB closes
# the gap rather than leaving it, so every later tournament that year shifts
# down by 15 per lost basho. Format: season:offset, comma separated.
# SUMO_SEASON_OFFSETS=2027:-15
