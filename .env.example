# Copy to .env and edit.

# Shared secret used by BOTH the Newznab indexer and the SABnzbd download
# client in Sonarr. Generate one with:  openssl rand -hex 16
SUMO_API_KEY=changeme

# Host directory holding incomplete/ and complete/. Sonarr must see the same
# files, either at the same path or via a Remote Path Mapping.
DOWNLOADS_DIR=./downloads

TZ=Asia/Tokyo
